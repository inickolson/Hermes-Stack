
# --- Hermes Dashboard auth (v20+) ---
# ВАЖНО: до v20 использовались HERMES_DASH_PASSWORD / HERMES_DASH_SECRET —
# эти имена больше не поддерживаются, dashboard проигнорирует их и
# отдаст пустой auth provider.
HERMES_DASHBOARD=1
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=CHANGE-ME
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=CHANGE-ME
# генерировать: openssl rand -base64 32
HERMES_DASHBOARD_BASIC_AUTH_SECRET=CHANGE-ME
